# ==========================================================
# 构建产物
# ==========================================================
# bin/obj 合计约 359 MB，含自包含单文件发布产物（SystemInfoGUI.exe 约 116 MB），
# 均可通过 dotnet build / dotnet publish 重新生成，绝不可入库。
bin/
obj/
publish/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/

# 编译输出与调试符号
*.exe
*.dll
*.pdb
*.deps.json
*.runtimeconfig.json

# ==========================================================
# IDE 与编辑器
# ==========================================================
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.userprefs
*.sln.docstates

# ==========================================================
# NuGet
# ==========================================================
packages/
*.nupkg
*.snupkg
project.lock.json
project.assets.json

# ==========================================================
# 操作系统
# ==========================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==========================================================
# WorkBuddy 工具数据
# ==========================================================
# 完全忽略：该目录由工具自动维护，记忆日志在每次任务后都会变动，
# 纳入版本管理会产生大量无意义的提交噪音。
# 项目约定与已知陷阱已沉淀在代码注释（如 InfoGroup.cs、SystemInfoForm.ReadGroup）与文档中。
.workbuddy/
