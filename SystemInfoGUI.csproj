<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 发布产物直接输出到项目根目录的 publish\，取代默认的多层路径
         bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\。
         注意：本工程为 PublishSingleFile，发布结果仅一个 SystemInfoGUI.exe，
         放在根目录便于分发；该目录已被 .gitignore 的 publish/ 与 *.exe 规则忽略。 -->
    <PublishDir>publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- 说明：原先的 RemoveUnwantedRuntimes 目标已删除。
       本工程为 PublishSingleFile，发布后 PublishDir 下不存在 runtimes 目录，该目标为空操作。 -->
</Project>